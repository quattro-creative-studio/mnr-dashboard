{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-redis": "*",
        "bugsnag/bugsnag-laravel": "^2.0",
        "fpdf/fpdf": "^1.90",
        "laravel/framework": "^13.0",
        "laravel/ui": "^4.6",
        "laravel/tinker": "^3.0",
        "phpoffice/phpspreadsheet": "^5.9"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "spatie/laravel-ignition": "^2.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "upgrade-notes": {
            "advisories-block": "RESTORED to true on 21 August 2026, at the Laravel 13 hop. It was false only while climbing from 5.7: every end-of-life version in between carries published advisories and Composer 2.10 refuses to install them, so the climb was impossible with the block on. No intermediate version was ever deployed. AdvisoryPolicyTest enforces that it stays true from Laravel 13 onward.",
            "platform-php": "config.platform.php pins the PHP version dependency resolution targets, independently of whichever PHP runs composer. Bump it at each PHP hop: 7.4.33 -> 8.0 -> 8.1 -> 8.2 -> 8.3+."
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta"
        ],
        "test": "bin/test"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "policy": {
            "advisories": {
                "block": true
            }
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
