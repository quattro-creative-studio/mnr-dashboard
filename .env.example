APP_NAME="Mission Nichtrauchen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP is used for every environment. The provider is chosen purely by the
# values below -- switching vendors never requires a code or package change.
#
#   SparkPost (EU)   host smtp.eu.sparkpostmail.com  user SMTP_Injection
#                    password = an API key with "Send via SMTP" permission
#   Scaleway TEM     host smtp.tem.scaleway.com      user = the Project ID
#                    password = an API key scoped to Transactional Email
#
# There is no MAIL_ENCRYPTION: Laravel 13 ignores it. Port 587 with an empty
# MAIL_SCHEME negotiates STARTTLS; use MAIL_SCHEME=smtps only on port 465.
# MAIL_REQUIRE_TLS defaults to true -- set it false only for a local sink such
# as Mailpit, which speaks no TLS.
#
# MAIL_FROM_ADDRESS must sit on a domain verified at the provider, or every
# send is rejected at the envelope.
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO=

# Set on developer machines pointed at a live provider: every message goes here
# instead of to real teachers. MUST stay empty in production.
MAIL_ALWAYS_TO=

BUGSNAG_API_KEY=

MNR_MIN_QUIZ_RESPONSES=5

